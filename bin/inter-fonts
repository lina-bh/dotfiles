#!/bin/sh
set -eu
get() {
  if command -v curl >/dev/null; then
    curl -fL "$1"
  else
    wget -O- "$1"
  fi
}

download() {
  if command -v curl >/dev/null; then
    curl -fL --output-dir "$2" -o "$3" "$1"
  else
    wget -P"$2" -O"$3" "$1"
  fi
}

extract() {
  tmpdir="$(mktemp -d)"
  trap 'rm -r "$tmpdir"' EXIT

  download "$1" "$tmpdir" "fonts.zip"
  unzip -o "${tmpdir}/fonts.zip" -d "${HOME}/.local/share/fonts" -x 'web/*' 'extras/*' '*.txt'
}

mkdir -p "${HOME}/.local/share/fonts"
extract "$(get "https://api.github.com/repos/rsms/inter/releases/latest" | grep browser_download_url | sed -re 's/.*"browser_download_url":.*"(.+).*"/\1/')"
command -v fc-cache >/dev/null && fc-cache
