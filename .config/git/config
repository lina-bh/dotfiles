[alias]
	ci = "commit"
	st = "status"
	upsub = "!git submodule update --init --recursive"
	checkin = "!git commit -m '' --allow-empty-message"
	hub = "!git config user.name lina-bh && git config user.email 36717206+lina-bh@users.noreply.github.com"
	uni = "!git config user.name 'Lina Bhaile' && git config user.email lb2894y@gre.ac.uk && git config --local --get-regexp user"
	emacs-devel = "!git config user.name 'Lina Bhaile' && git config user.email emacs-devel@linabee.uk"
        lab = "!git config user.name 'Lina' && git config user.email 4982999-linabee@users.noreply.gitlab.com"
        berg = "!git config user.name 'lina-bh' && git config user.email lina-bh@noreply.codeberg.org"
	cia = "commit --all"
	amend = "commit --amend"
	extend = "commit --amend --no-edit --allow-empty-message"
	root = "rev-parse --show-toplevel"

[user]
	useConfigOnly = true

[init]
	defaultBranch = main
[commit]
	verbose = true
[github]
	user = lina-bh
