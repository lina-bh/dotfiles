[Container]
GlobalArgs=--hooks-dir=%h/.config/containers/oci/hooks.d
AutoUpdate=registry
Image=ghcr.io/qdm12/gluetun:latest
ContainerName=gluetun
AddDevice=/dev/net/tun
AddCapability=NET_ADMIN
NoNewPrivileges=true
Environment=VPN_SERVICE_PROVIDER=mullvad
Environment=VPN_TYPE=wireguard
Environment=WIREGUARD_ADDRESSES='10.70.124.70/32,fc00:bbbb:bbbb:bb01::7:7c45/128'
Environment=SERVER_COUNTRIES=UK
Secret=mullvad-wg-key,type=env,target=WIREGUARD_PRIVATE_KEY
HealthCmd=/gluetun-entrypoint healthcheck
HealthInterval=5s
HealthTimeout=5s
HealthStartPeriod=10s
HealthRetries=1
Notify=healthy
PublishPort=127.0.0.1:8080:8080/tcp
