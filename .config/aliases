# vim: set ft=bash
alias juserctl='journalctl --user'
alias ls='ls -FHh --color=auto'
alias rsync='rsync --recursive --sparse --preallocate --progress --partial --human-readable --fsync'
alias userctl='systemctl --user'
alias vim=nvim
#alias aria2c='podman run --rm --tty --interactive --security-opt=label=disable --userns=host --mount=type=bind,src=.,target=/workdir --read-only aria2c'
alias mpv='flatpak run io.mpv.Mpv'
alias flatpak='flatpak --user'
alias flyctl='podman run --rm --interactive --tty --security-opt=label=disable --env=HOME="$HOME" --mount=type=bind,src="$HOME"/.fly,target="$HOME"/.fly --mount=type=bind,src="$PWD",target="$PWD" --workdir="$PWD" --userns=host flyio/flyctl'
alias fly=flyctl
